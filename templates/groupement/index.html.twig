
{% extends 'base.html.twig' %}

{% block title %}Liste des groupements{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h1 class="mb-4">Liste des groupements</h1>

        {# Formulaire de filtrage #}
        <div class="card mb-4 shadow-sm">
            <div class="card-body p-4">

                {{ form_start(form) }}

                    <div class="row g-3 align-items-end">

                        <div class="col-md-5">
                            {{ form_row(form.tel) }}
                        </div>

                        <div class="col-md-5">
                            {{ form_row(form.adresse) }}
                        </div>

                        <div class="col-md-2">
                            {{ form_row(form.rechercher) }}
                        </div>

                    </div>

                {{ form_end(form) }}

            </div>
        </div>

        {# Liste des groupements #}
        {% if groupements is empty %}

            <div class="alert alert-info">
                Aucun groupement ne correspond à votre recherche.
            </div>

        {% else %}

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Adresse</th>
                            <th>Téléphone</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for groupement in groupements %}
                            <tr>
                                <td>{{ groupement.id }}</td>
                                <td>{{ groupement.nom }}</td>
                                <td>{{ groupement.adresse ?? '-' }}</td>
                                <td>{{ groupement.tel }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

            {# Informations sur les résultats #}
            <div class="text-muted text-center mb-3">
                {{ result.total }} groupement(s) trouvé(s)
                — Page {{ result.page }} sur {{ result.totalPages }}
            </div>

            {# Pagination #}
            {% if result.totalPages > 1 %}

                <nav aria-label="Pagination des groupements">
                    <ul class="pagination justify-content-center">

                        {% for page in 1..result.totalPages %}

                            <li class="page-item {{ page == result.page ? 'active' : '' }}">
                                <a class="page-link"
                                   href="{{ path(
                                       'app_groupement',
                                       app.request.query.all|merge({'page': page})
                                   ) }}">
                                    {{ page }}
                                </a>
                            </li>

                        {% endfor %}

                    </ul>
                </nav>

            {% endif %}

        {% endif %}

    </div>
{% endblock %}
