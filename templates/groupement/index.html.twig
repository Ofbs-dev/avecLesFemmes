{% extends 'base.html.twig' %}

{% block title %}Liste des groupements{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des groupements</h1>

    {% if groupements is empty %}
        <div class="alert alert-info">
            Aucun groupement enregistré pour le moment.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Montant</th>
                        <th>Adresse</th>
                        <th>Téléphone</th>
                    </tr>
                </thead>
                <tbody>
                    {% for groupement in groupements %}
                        <tr>
                            <td>{{ groupement.id }}</td>
                            <td>{{ groupement.montant }}</td>
                            <td>{{ groupement.adresse }}</td>
                            <td>{{ groupement.tel }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}