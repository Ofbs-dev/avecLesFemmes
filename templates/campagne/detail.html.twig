
{% extends 'base.html.twig' %}

{% block title %}Détails de la campagne{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Détails de la campagne</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table">
                <tr>
                    <th>ID</th>
                    <td>{{ campagne.id }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ campagne.nom }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ campagne.typeCampagne.nom }}</td>
                </tr>
                <tr>
                    <th>Date de début</th>
                    <td>{{ campagne.dateDebutAt|date('d/m/Y') }}</td>
                </tr>
                <tr>
                    <th>Date de fin</th>
                    <td>{{ campagne.dateFinAt ? campagne.dateFinAt|date('d/m/Y') : '-' }}</td>
                </tr>
                <tr>
                    <th>Montant</th>
                    <td>{{ campagne.montant|number_format(0, ',', ' ') }} FCFA</td>
                </tr>
            </table>

            <a href="{{ path('app_campagne_modifier', {id: campagne.id}) }}"
               class="btn btn-warning">Modifier</a>

            <a href="{{ path('app_campagne') }}"
               class="btn btn-secondary">Retour</a>
        </div>
    </div>
</div>
{% endblock %}
